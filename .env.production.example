# ==============================================================================
# GitHub AI Workspace - Production Environment Configuration Template
# ==============================================================================

# Application & Server
APP_ENV=production
APP_DEBUG=false
PORT=8000
HOST=0.0.0.0
FRONTEND_URL=http://localhost:3000

# Security & Sessions (Must be replaced with a 32+ character high-entropy key)
SECRET_KEY=generate-a-secure-random-64-character-production-key-here
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_PER_MINUTE=120

# Database (SQLite with WAL journal mode)
DATABASE_URL=sqlite+aiosqlite:///storage/github_agent.db

# Storage & Local Git Workspaces
WORKSPACE_DIR=storage/workspaces
AUDIT_LOG_RETENTION_DAYS=90

# AI Provider Configuration (Default: Local Ollama)
DEFAULT_AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5-coder:7b
DEFAULT_TEMPERATURE=0.2
REQUEST_TIMEOUT_SECONDS=45
MAX_RETRY_COUNT=3
MAX_TOOL_CALLS=10

# Cloud Privacy Guardrail: Keep false to prevent transmission of private source code to cloud models
ALLOW_CLOUD_CODE_ANALYSIS=false
ENABLE_CLOUD_FALLBACK=false

# Optional Cloud Providers (only used if ALLOW_CLOUD_CODE_ANALYSIS=true)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# GitHub Integration
# Use fine-grained GitHub PAT with minimal repository permissions
GITHUB_PERSONAL_ACCESS_TOKEN=
GITHUB_MCP_TRANSPORT=stdio
GITHUB_MCP_COMMAND=npx -y @modelcontextprotocol/server-github

# Human-In-The-Loop Approval Engine
REQUIRE_APPROVAL_FOR_MUTATIONS=true
AUTO_APPROVE_SAFE_READS=true
APPROVAL_DEFAULT_TTL_MINUTES=30
