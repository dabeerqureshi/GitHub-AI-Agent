# ==============================================================================
# GitHub AI Workspace - Environment Configuration Template
# ==============================================================================

# Application & Server
APP_ENV=development
APP_DEBUG=true
PORT=8000
HOST=0.0.0.0
FRONTEND_URL=http://localhost:3000

# Security & Sessions
SECRET_KEY=replace-with-a-secure-random-32-byte-hex-string-in-production
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_PER_MINUTE=60

# Database (SQLite with WAL mode)
DATABASE_URL=sqlite+aiosqlite:///./storage/github_agent.db

# Storage & Local Git Workspaces
WORKSPACE_DIR=./storage/workspaces
AUDIT_LOG_RETENTION_DAYS=90

# AI Provider Configuration
# Supported providers: ollama (default), openai, anthropic
DEFAULT_AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Optional Cloud AI Providers (leave blank if local-only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# GitHub Integration
# Personal Access Token (PAT) with repo and read:org scope
GITHUB_PERSONAL_ACCESS_TOKEN=
GITHUB_MCP_TRANSPORT=stdio
# Command or container to spawn GitHub MCP server
GITHUB_MCP_COMMAND=npx -y @modelcontextprotocol/server-github

# Human-In-The-Loop Security
REQUIRE_APPROVAL_FOR_MUTATIONS=true
AUTO_APPROVE_SAFE_READS=true
